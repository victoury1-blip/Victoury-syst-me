# Copy to .env for local testing only. Never commit the real .env file.
# In production (GitHub Actions), set these as repository secrets instead:
# Settings -> Secrets and variables -> Actions -> New repository secret

META_ACCESS_TOKEN=your_long_lived_access_token
META_AD_ACCOUNT_ID=act_XXXXXXXXXXXXX

# Optional: Telegram alerts (leave blank to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
